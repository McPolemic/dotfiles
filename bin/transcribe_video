#!/bin/sh

# Function to display help information
help() {
  echo "Usage: $0 [-f FORMAT] VIDEO_FILE"
  echo
  echo "Transcribe a video file using whisper."
  echo
  echo "Options:"
  echo "  -f, --format FORMAT   Output format passed to whisper (txt, srt, etc). Defaults to srt."
  echo "  -v, --verbose         Print progress messages to stderr."
  echo "  -h, --help            Display this help message and exit."
}

format=srt
verbose=false

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--format)
      format="$2"
      shift
      ;;
    -v|--verbose)
      verbose=true
      ;;
    -h|--help)
      help
      exit 0
      ;;
    *)
      video_file="$1"
      ;;
  esac
  shift
done

if [ -z "$video_file" ]; then
  help
  exit 1
fi

# Log function
log() {
  if [ "$verbose" = true ]; then
    echo "$1" >&2
  fi
}

log "Transcribing with whisper..."
log "Transcribing video file..."
whisper --output_format "$format" "$video_file" >/dev/null 2>&1
log "Transcription complete"
