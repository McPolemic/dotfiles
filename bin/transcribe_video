#!/bin/sh

# Function to display help information
help() {
  echo "Usage: $0 [-f FORMAT] VIDEO_FILE"
  echo
  echo "Transcribe a video file using whisper.cpp."
  echo
  echo "Options:"
  echo "  -f, --format FORMAT   Output format (txt, srt, vtt, csv, json, lrc). Defaults to srt."
  echo "  -v, --verbose         Print progress messages to stderr."
  echo "  -h, --help            Display this help message and exit."
  echo
  echo "The model defaults to \$WHISPER_MODEL, or ~/.cache/whisper.cpp/ggml-large-v3-turbo.bin."
  echo "The transcript is written next to VIDEO_FILE."
}

format=srt
verbose=false
model="${WHISPER_MODEL:-$HOME/.cache/whisper.cpp/ggml-large-v3-turbo.bin}"

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--format)
      format="$2"
      shift
      ;;
    -v|--verbose)
      verbose=true
      ;;
    -h|--help)
      help
      exit 0
      ;;
    *)
      video_file="$1"
      ;;
  esac
  shift
done

if [ -z "$video_file" ]; then
  help
  exit 1
fi

# Log function
log() {
  if [ "$verbose" = true ]; then
    echo "$1" >&2
  fi
}

die() {
  echo "transcribe_video: $1" >&2
  exit 1
}

case "$format" in
  txt)  format_flag=-otxt ;;
  srt)  format_flag=-osrt ;;
  vtt)  format_flag=-ovtt ;;
  csv)  format_flag=-ocsv ;;
  json) format_flag=-oj ;;
  lrc)  format_flag=-olrc ;;
  *)    die "unsupported format '$format' (use txt, srt, vtt, csv, json, or lrc)" ;;
esac

[ -f "$video_file" ] || die "no such file: $video_file"
[ -f "$model" ] || die "model not found: $model"
command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg is required but not on PATH"
command -v whisper-cli >/dev/null 2>&1 || die "whisper-cli is required but not on PATH (brew install whisper-cpp)"

# whisper.cpp only reads 16 kHz mono audio, so decode the video first.
wav_file=$(mktemp -t transcribe_video) || die "could not create temporary file"
wav_file="$wav_file.wav"
trap 'rm -f "$wav_file"' EXIT INT TERM

file_name=${video_file##*/}
case "$video_file" in
  */*) directory="${video_file%/*}/" ;;
  *)   directory="" ;;
esac
output_stem="${directory}${file_name%.*}"

log "Extracting audio..."
if ! ffmpeg -y -v error -i "$video_file" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$wav_file"; then
  die "ffmpeg failed to extract audio from $video_file"
fi

log "Transcribing with whisper.cpp..."
if [ "$verbose" = true ]; then
  whisper-cli -m "$model" -l en -f "$wav_file" "$format_flag" -of "$output_stem" -pp || die "whisper-cli failed"
else
  whisper_output=$(whisper-cli -m "$model" -l en -f "$wav_file" "$format_flag" -of "$output_stem" -np 2>&1) || {
    echo "$whisper_output" >&2
    die "whisper-cli failed"
  }
fi

log "Transcription complete: $output_stem.$format"
